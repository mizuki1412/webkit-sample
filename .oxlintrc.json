{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "perf": "warn"
    },
    "plugins": [
        "import",
        "unicorn",
        "oxc"
    ],
    "env": {
        "browser": true,
        "es2024": true
    },
    "globals": {
        // unplugin-vue-components 自动引入的组件与宏
        "defineProps": "readonly",
        "defineEmits": "readonly",
        "defineModel": "readonly",
        "defineExpose": "readonly",
        "withDefaults": "readonly"
    },
    "ignorePatterns": [
        "dist/**",
        "node_modules/**",
        "auto-imports.d.ts",
        "components.d.ts"
    ]
}