{
  "$description": "Aurora design language. Source: design/pics/30b0f259164b06e182a77f475edc3c34.webp (PROJEX 项目管理看板). 活泼的 SaaS 蓝：皇家蓝大色块 + 白卡片 + 粉彩分类色 + 大圆角。DTCG format.",
  "$scheme": "light",
  "$source": "pics/30b0f259164b06e182a77f475edc3c34.webp",
  "color": {
    "$type": "color",
    "bg": { "$value": "#F0F3FA", "$description": "页面画布。实测占比 22.5% 的浅蓝灰。" },
    "surface": { "$value": "#FFFFFF", "$description": "卡片/面板一级表面。实测 42.6%。" },
    "surface-raised": { "$value": "#F5F8FC", "$description": "二级面：输入框、分段控件底、悬停态。实测 2.4%。" },
    "border": { "$value": "#E8ECF6", "$description": "1px 分隔线/卡片描边。实测 #E8ECF6 色块。" },
    "border-strong": { "$value": "#D5DCEC", "$description": "强调描边：输入框 hover/focus 外沿。" },
    "text": { "$value": "#253044", "$description": "主文本。标题近黑（测量受抗锯齿影响，取目测中值）。" },
    "text-muted": { "$value": "#6B7A99", "$description": "次级文本、导航未选中、说明文字。" },
    "text-faint": { "$value": "#9AA6BE", "$description": "三级文本：轴标签、占位符、时间戳。" },
    "accent": { "$value": "#005EFD", "$description": "皇家蓝。实测 20.4%（侧栏大色块 + 主按钮 + 选中卡片），语义权重最高。" },
    "accent-ink": { "$value": "#FFFFFF", "$description": "accent 上的文字与图标。" },
    "accent-weak": { "$value": "#005EFD14", "$description": "accent 8% 弱底：选中行/标签背景。" },
    "positive": { "$value": "#2FBF71", "$description": "成功/上涨。事件粉彩绿 #B5F3D5 的语义化深色。" },
    "positive-weak": { "$value": "#2FBF7120", "$description": "positive 12% 弱底。" },
    "negative": { "$value": "#F25555", "$description": "危险/删除。卡片左边橙红条的语义化。" },
    "negative-weak": { "$value": "#F2555520", "$description": "negative 12% 弱底。" },
    "warning": { "$value": "#F5A623", "$description": "警告。卡片黄色左边条语义化。" },
    "warning-weak": { "$value": "#F5A62320", "$description": "warning 12% 弱底。" },
    "data-1": { "$value": "#005EFD", "$description": "图表主色 = accent。" },
    "data-2": { "$value": "#8B77F7", "$description": "图表紫。事件粉彩紫 #D9CFFE 的深色。" },
    "data-3": { "$value": "#F78EA7", "$description": "图表粉。事件粉彩粉 #FFD3D9 的深色。" },
    "chart-grid": { "$value": "#E4E9F4", "$description": "日历/图表网格线。" },
    "chart-area": { "$value": "#005EFD1F", "$description": "面积图 12% 填充。" },
    "sidebar": { "$value": "#005EFD", "$description": "侧栏整条为皇家蓝大色块（样图最显著特征）。" },
    "sidebar-text": { "$value": "#D7E2FD", "$description": "侧栏未选中项文字（白 84%）。" },
    "sidebar-text-muted": { "$value": "#B4C6F5", "$description": "侧栏图标/三级。" },
    "sidebar-active-bg": { "$value": "#FFFFFF", "$description": "选中项 = 白色胶囊（蓝底上跳白）。" },
    "sidebar-active-text": { "$value": "#005EFD", "$description": "选中项文字/图标 = 蓝。" },
    "header": { "$value": "#F0F3FA", "$description": "顶栏与画布同色（无独立条）。" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "8px", "$description": "小控件：标签、badge。" },
    "sm": { "$value": "10px", "$description": "按钮、输入框。" },
    "md": { "$value": "14px", "$description": "分段控件、弹窗内块。" },
    "lg": { "$value": "20px", "$description": "卡片/面板。样图圆角感最强的层级。" },
    "full": { "$value": "999px", "$description": "胶囊：搜索框、分段控件、头像、日期事件。" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["system-ui", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "sans-serif"],
      "$description": "样图用几何圆润无衬线（Poppins 系）；无网络字体时用系统栈表达同级亲和力。"
    },
    "size": {
      "$type": "dimension",
      "micro": { "$value": "11px", "$description": "badge/时间戳。" },
      "xs": { "$value": "12px", "$description": "辅助说明。" },
      "sm": { "$value": "13px", "$description": "正文次要。" },
      "base": { "$value": "14px", "$description": "正文/控件。" },
      "md": { "$value": "16px", "$description": "卡片标题。" },
      "lg": { "$value": "20px", "$description": "区块标题。" },
      "xl": { "$value": "24px", "$description": "页标题。" },
      "display": { "$value": "30px", "$description": "数据大字。" }
    },
    "weight": {
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700, "$description": "标题偏粗，圆润风需要字重撑。" }
    },
    "leading": {
      "none": { "$value": 1 },
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.5 }
    },
    "tracking": {
      "micro": { "$value": "0.08em", "$description": "全大写 badge。" },
      "normal": { "$value": "0em" },
      "tight": { "$value": "-0.01em", "$description": "大标题轻微收紧。" },
      "caps": { "$value": "0.05em" }
    }
  },
  "layout": {
    "$type": "dimension",
    "sidebar": { "$value": "256px", "$description": "样图侧栏约占 1600 宽的 17%。实测 gutter 推算。" },
    "topbar": { "$value": "72px", "$description": "样图顶栏含胶囊搜索，偏高。" },
    "gap": { "$value": "24px", "$description": "卡片间距（4px 网格实测 base=4）。" },
    "card-pad": { "$value": "24px" },
    "control-h": { "$value": "40px", "$description": "胶囊搜索/主按钮偏高，亲和感来源之一。" },
    "control-h-sm": { "$value": "32px" },
    "content-x": { "$value": "32px" },
    "content-y": { "$value": "24px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": { "offsetX": 0, "offsetY": 8, "blur": 24, "spread": 0, "color": "#005EFD14" },
      "$description": "白卡片浮在画布上的柔和蓝影。Aurora 是三语言中唯一允许阴影的。"
    }
  },
  "motion": {
    "duration-fast": { "$type": "dimension", "$value": "140ms" },
    "duration-base": { "$type": "dimension", "$value": "200ms" },
    "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "chart": {
    "line-width": { "$type": "dimension", "$value": "2.5px", "$description": "样图折线明显偏粗圆润。" },
    "grid-width": { "$type": "dimension", "$value": "1px" }
  }
}
