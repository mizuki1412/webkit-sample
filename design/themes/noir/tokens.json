{
  "$description": "Noir design language. Source: design/pics/9e86025a06aa77238927e02082f6b2fd.jpg (金融仪表盘，双明暗样图，取其暗色变体为本语言主体). 极简金融风：近黑紫底 + 细描边 + 蓝主色 + 金色数据强调，小圆角、高密度。DTCG format.",
  "$scheme": "dark",
  "$source": "pics/9e86025a06aa77238927e02082f6b2fd.jpg",
  "color": {
    "$type": "color",
    "bg": { "$value": "#131118", "$description": "页面画布。实测暗色变体 #15141A/#131016 区间，取中值并压紫。" },
    "surface": { "$value": "#1B1920", "$description": "卡片一级表面。实测 #1B1920 色块。" },
    "surface-raised": { "$value": "#26232E", "$description": "控件/输入框/选中态。实测 #221F2A~#27242F 区间。" },
    "border": { "$value": "#FFFFFF14", "$description": "1px 描边 = 白 8%。金融暗色靠描边分层而非阴影。" },
    "border-strong": { "$value": "#FFFFFF26", "$description": "hover/焦点描边，白 15%。" },
    "text": { "$value": "#F4F3F7", "$description": "主文本近白。" },
    "text-muted": { "$value": "#9A94AC", "$description": "次级文本、轴标签。" },
    "text-faint": { "$value": "#655F75", "$description": "三级文本、禁用。" },
    "accent": { "$value": "#4972FE", "$description": "金融蓝。实测 #4972FE（Transfer 按钮/选中图表项/卡片强调条）。" },
    "accent-ink": { "$value": "#FFFFFF", "$description": "accent 上的文字。" },
    "accent-weak": { "$value": "#4972FE29", "$description": "accent 16% 弱底：tooltip 底、选中背景。" },
    "positive": { "$value": "#3DD68C", "$description": "+2.43% 涨幅绿。" },
    "positive-weak": { "$value": "#3DD68C1C", "$description": "positive 11% 弱底胶囊。" },
    "negative": { "$value": "#F0574F", "$description": "-$ 金额红。" },
    "negative-weak": { "$value": "#F0574F1C", "$description": "negative 11% 弱底。" },
    "warning": { "$value": "#E8B339", "$description": "金色数据强调（Total Saved 折线）。仅数据语义，不做状态色。" },
    "warning-weak": { "$value": "#E8B33924", "$description": "warning 14% 弱底。" },
    "data-1": { "$value": "#4972FE", "$description": "主数据线 = accent。" },
    "data-2": { "$value": "#723DED", "$description": "紫（暗色卡片、会员卡）。实测 #723DED。" },
    "data-3": { "$value": "#E8B339", "$description": "金数据线。" },
    "chart-grid": { "$value": "#FFFFFF0F", "$description": "图表网格 = 白 6%。" },
    "chart-area": { "$value": "#4972FE29", "$description": "面积填充。" },
    "sidebar": { "$value": "#131118", "$description": "侧栏与画布同色，仅靠右描边分隔（极简特征）。" },
    "sidebar-text": { "$value": "#B9B3C7", "$description": "图标项未选中。" },
    "sidebar-text-muted": { "$value": "#8B8598", "$description": "禁用/三级。" },
    "sidebar-active-bg": { "$value": "#4972FE", "$description": "选中项 = 蓝色圆角方块（窄图标栏）。" },
    "sidebar-active-text": { "$value": "#FFFFFF", "$description": "选中图标白。" },
      "header": { "$value": "#131118", "$description": "头部区画布。Noir 无贯通顶栏条带——顶部件直接浮在同色画布上（DESIGN.md 规则 7），值同 bg 仅作语义契约兼容。" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px", "$description": "badge、小标签。" },
    "sm": { "$value": "6px", "$description": "输入框、次按钮。" },
    "md": { "$value": "8px", "$description": "按钮、菜单项。" },
    "lg": { "$value": "12px", "$description": "卡片。实测 ~10-12。" },
    "full": { "$value": "999px", "$description": "胶囊（仅日期范围、开关）。" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Inter", "Segoe UI", "system-ui", "PingFang SC", "Microsoft YaHei", "sans-serif"],
      "$description": "样图为中性 grotesque（Inter 系）；金额数字用 semibold + tabular。"
    },
    "size": {
      "$type": "dimension",
      "micro": { "$value": "10px", "$description": "轴标签、交易时间。" },
      "xs": { "$value": "11px", "$description": "辅助。" },
      "sm": { "$value": "12px", "$description": "正文次要，高密度。" },
      "base": { "$value": "13px", "$description": "正文/控件。金融密度下整体缩一档。" },
      "md": { "$value": "15px", "$description": "卡片标题。" },
      "lg": { "$value": "18px", "$description": "区块标题。" },
      "xl": { "$value": "22px", "$description": "页标题。" },
      "display": { "$value": "28px", "$description": "金额大字 $29,800.65。" }
    },
    "weight": {
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600, "$description": "金额/标题主字重。" },
      "bold": { "$value": 700 }
    },
    "leading": {
      "none": { "$value": 1 },
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.25 },
      "normal": { "$value": 1.45 }
    },
    "tracking": {
      "micro": { "$value": "0.1em", "$description": "全大写 micro 标签。" },
      "normal": { "$value": "0em" },
      "tight": { "$value": "-0.02em", "$description": "大数字收紧。" },
      "caps": { "$value": "0.04em" }
    }
  },
  "layout": {
    "$type": "dimension",
    "sidebar": { "$value": "72px", "$description": "窄图标栏（样图最显著布局特征）。" },
    "topbar": { "$value": "56px", "$description": "顶部区节奏参考值（顶部件 control-h 36 + 上下留白组装；Noir 无贯通条带，非条带高度）。" },
    "gap": { "$value": "16px", "$description": "高密度卡片间距。实测 gutter 众数 16/20。" },
    "card-pad": { "$value": "20px" },
    "control-h": { "$value": "36px" },
    "control-h-sm": { "$value": "28px" },
    "content-x": { "$value": "24px" },
    "content-y": { "$value": "20px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "none",
      "$description": "描边分层语言：全语言禁用阴影（见 DESIGN.md 主张 #1）。"
    }
  },
  "motion": {
    "duration-fast": { "$type": "dimension", "$value": "120ms" },
    "duration-base": { "$type": "dimension", "$value": "180ms" },
    "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "chart": {
    "line-width": { "$type": "dimension", "$value": "2px" },
    "grid-width": { "$type": "dimension", "$value": "1px" }
  }
}
