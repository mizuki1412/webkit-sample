{
  "$description": "Porcelain design language. Source: design/pics/ec71aa5bdb76f08b598df0c55ed63b3c.webp (Commercehq 电商运营台). 干净的浅色商务风：淡紫灰画布 + 纯白面板 + 商务蓝 + 海军蓝标题 + 全大写字距标签，小圆角、紧凑。DTCG format.",
  "$scheme": "light",
  "$source": "pics/ec71aa5bdb76f08b598df0c55ed63b3c.webp",
  "color": {
    "$type": "color",
    "bg": { "$value": "#E9EDF5", "$description": "画布。实测外框 #DCE3EF(29.2%) 偏饱和，应用内取其淡化中值；面板外的留白层。" },
    "surface": { "$value": "#FFFFFF", "$description": "面板/卡片。实测 28.5%。" },
    "surface-raised": { "$value": "#F5F7FB", "$description": "内嵌画布/表头/次级块。实测 23.4%。" },
    "border": { "$value": "#DDE3EE", "$description": "1px 面板描边。实测 #D4DBE9~#D0D6E7 区间取轻。" },
    "border-strong": { "$value": "#C7D0E0", "$description": "输入框描边/hover。" },
    "text": { "$value": "#232E4E", "$description": "主文本。样图标题为海军蓝（实测 #010B48 色块），正文取混合中值。" },
    "text-heading": { "$value": "#0B1B4D", "$description": "标题/区块大写字用海军蓝，本语言签名色。附加角色。" },
    "text-muted": { "$value": "#6E7891", "$description": "次级文本、导航未选中。" },
    "text-faint": { "$value": "#9AA3BA", "$description": "三级、占位符。" },
    "accent": { "$value": "#3A78F2", "$description": "商务蓝。实测 #3A78F2 占 4.1%（柱图/按钮/进度线）。" },
    "accent-ink": { "$value": "#FFFFFF", "$description": "accent 上的文字。" },
    "accent-weak": { "$value": "#3A78F21A", "$description": "accent 10% 弱底。" },
    "positive": { "$value": "#17A34A", "$description": "+27% 涨幅绿。" },
    "positive-weak": { "$value": "#17A34A1A", "$description": "positive 10% 弱底。" },
    "negative": { "$value": "#E5484D", "$description": "↓34% 跌幅红。" },
    "negative-weak": { "$value": "#E5484D1A", "$description": "negative 10% 弱底。" },
    "warning": { "$value": "#F0A020", "$description": "警告（样图未出现，按同明度推断补充）。" },
    "warning-weak": { "$value": "#F0A0201A", "$description": "warning 10% 弱底。" },
    "data-1": { "$value": "#3A78F2", "$description": "柱图主色 = accent。" },
    "data-2": { "$value": "#8FB4FA", "$description": "柱图浅蓝（对比柱/上月）。" },
    "data-3": { "$value": "#0B1B4D", "$description": "海军蓝数据/进度线。" },
    "chart-grid": { "$value": "#E4E9F4", "$description": "图表网格。" },
    "chart-area": { "$value": "#3A78F21A", "$description": "面积填充。" },
    "sidebar": { "$value": "#FFFFFF", "$description": "侧栏白底（与样图一致），选中项 = 蓝底白字按钮 + 左侧蓝 notch。" },
    "sidebar-text": { "$value": "#4A5670", "$description": "未选中项文字。" },
    "sidebar-text-muted": { "$value": "#8791A8", "$description": "图标/三级。" },
    "sidebar-active-bg": { "$value": "#3A78F2", "$description": "选中项蓝色块。" },
    "sidebar-active-text": { "$value": "#FFFFFF", "$description": "选中项白字。" },
    "header": { "$value": "#FFFFFF", "$description": "顶栏白底 + 底描边。" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px", "$description": "badge。" },
    "sm": { "$value": "6px", "$description": "小按钮、输入内件。" },
    "md": { "$value": "8px", "$description": "按钮/输入/小卡。样图控件圆角一致偏小。" },
    "lg": { "$value": "10px", "$description": "面板/卡片。实测 ~8-10。" },
    "full": { "$value": "999px", "$description": "头像、图标圆底。" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Inter", "Segoe UI", "system-ui", "PingFang SC", "Microsoft YaHei", "sans-serif"],
      "$description": "中性 grotesque。区块标签全大写 + 宽字距是本语言签名。"
    },
    "size": {
      "$type": "dimension",
      "micro": { "$value": "10px", "$description": "全大写区块标签。" },
      "xs": { "$value": "11px", "$description": "辅助。" },
      "sm": { "$value": "12px", "$description": "表格次级/说明。" },
      "base": { "$value": "13px", "$description": "正文/控件，紧凑。" },
      "md": { "$value": "15px", "$description": "卡片标题。" },
      "lg": { "$value": "18px", "$description": "区块标题。" },
      "xl": { "$value": "22px", "$description": "页标题。" },
      "display": { "$value": "26px", "$description": "$549,735.00 数据大字。" }
    },
    "weight": {
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700, "$description": "金额大字。" }
    },
    "leading": {
      "none": { "$value": 1 },
      "tight": { "$value": 1.12 },
      "snug": { "$value": 1.28 },
      "normal": { "$value": 1.45 }
    },
    "tracking": {
      "micro": { "$value": "0.1em", "$description": "全大写标签。" },
      "normal": { "$value": "0em" },
      "tight": { "$value": "-0.01em" },
      "caps": { "$value": "0.08em", "$description": "区块大写字距（本语言签名）。" }
    }
  },
  "layout": {
    "$type": "dimension",
    "sidebar": { "$value": "232px", "$description": "样图侧栏/画布比例推算。" },
    "topbar": { "$value": "64px" },
    "gap": { "$value": "16px", "$description": "紧凑网格。实测 gutter 众数 16。" },
    "card-pad": { "$value": "20px" },
    "control-h": { "$value": "34px", "$description": "控件整体偏矮，密度感。" },
    "control-h-sm": { "$value": "28px" },
    "content-x": { "$value": "24px" },
    "content-y": { "$value": "20px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": { "offsetX": 0, "offsetY": 1, "blur": 2, "spread": 0, "color": "#0B1B4D0F" },
      "$description": "几乎不可见的贴地影，商务克制。"
    }
  },
  "motion": {
    "duration-fast": { "$type": "dimension", "$value": "120ms" },
    "duration-base": { "$type": "dimension", "$value": "180ms" },
    "ease-standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "chart": {
    "line-width": { "$type": "dimension", "$value": "2px" },
    "grid-width": { "$type": "dimension", "$value": "1px" }
  }
}
