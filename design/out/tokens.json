{
  "$description": "Volt design language tokens. Derived from sample/mock.png: pixel measurements in measurements.json + semantic pass in semantic-map.json. DTCG format.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "#0B0D12",
      "$description": "页面画布。夜间蓝黑，不是纯黑。"
    },
    "surface": {
      "$value": "#12151C",
      "$description": "卡片、表格等一级承载面。靠亮度分层，不用阴影。"
    },
    "surface-raised": {
      "$value": "#171B24",
      "$description": "控件与二级面：输入框、分段控件、导航选中态。"
    },
    "border": {
      "$value": "#22252C",
      "$description": "1px 分隔线。白色 7% 叠在 surface 上的合成值。"
    },
    "text": {
      "$value": "#F2F5F9",
      "$description": "主文本、数字。近白，避免纯白刺眼。"
    },
    "text-muted": {
      "$value": "#8A93A6",
      "$description": "次级文本、图例、导航未选中。"
    },
    "text-faint": {
      "$value": "#5B6478",
      "$description": "三级文本：轴标签、表头、辅助说明。"
    },
    "accent": {
      "$value": "#C8F751",
      "$description": "电光青柠。只给主行动与主数据线，单屏面积 <= 5%。"
    },
    "accent-ink": {
      "$value": "#0E1206",
      "$description": "accent 上的文字与图标颜色。"
    },
    "accent-weak": {
      "$value": "#C8F7511F",
      "$description": "accent 12% 弱底，用于选中/高亮背景。"
    },
    "positive": {
      "$value": "#4ED8A0",
      "$description": "上涨、在线、成功。仅语义使用。"
    },
    "positive-weak": {
      "$value": "#4ED8A01C",
      "$description": "positive 11% 弱底，用于涨幅胶囊。"
    },
    "negative": {
      "$value": "#FF6B6B",
      "$description": "下跌、错误、危险。仅语义使用。"
    },
    "negative-weak": {
      "$value": "#FF6B6B1C",
      "$description": "negative 11% 弱底，用于跌幅胶囊。"
    },
    "data-1": {
      "$value": "#6E9BFF",
      "$description": "数据可视化第二序列（第一序列用 accent）。"
    },
    "data-2": {
      "$value": "#8A93A6",
      "$description": "数据可视化第三序列。"
    },
    "data-3": {
      "$value": "#3A4152",
      "$description": "数据可视化第四序列 / 空轨道。"
    },
    "chart-grid": {
      "$value": "#F2F5F90E",
      "$description": "图表横向网格线：白 5.5%。"
    },
    "chart-area": {
      "$value": "#C8F75129",
      "$description": "折线图面积渐变起点：accent 16%，结束为透明。"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "10": {
      "$value": "40px"
    },
    "12": {
      "$value": "48px"
    },
    "16": {
      "$value": "64px"
    }
  },
  "radius": {
    "$type": "dimension",
    "xs": {
      "$value": "8px",
      "$description": "小标记、菜单项。"
    },
    "sm": {
      "$value": "10px",
      "$description": "按钮、输入框、导航项。"
    },
    "lg": {
      "$value": "16px",
      "$description": "卡片、面板。"
    },
    "full": {
      "$value": "999px",
      "$description": "胶囊、开关、头像。"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Segoe UI",
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    },
    "size": {
      "$type": "dimension",
      "micro": {
        "$value": "10.5px",
        "$description": "大写微标签、表头。"
      },
      "xs": {
        "$value": "11.5px",
        "$description": "胶囊、图例、辅助信息。"
      },
      "sm": {
        "$value": "12.5px",
        "$description": "表格正文、按钮、搜索。"
      },
      "base": {
        "$value": "14px",
        "$description": "导航、卡片标题、正文。"
      },
      "md": {
        "$value": "16px",
        "$description": "强调数字、侧栏汇总。"
      },
      "lg": {
        "$value": "18px",
        "$description": "大号统计值。"
      },
      "xl": {
        "$value": "25px",
        "$description": "页面标题。"
      },
      "display": {
        "$value": "34px",
        "$description": "主余额、英雄数字。"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "leading": {
      "$type": "number",
      "none": {
        "$value": 1
      },
      "tight": {
        "$value": 1.1
      },
      "snug": {
        "$value": 1.25
      },
      "normal": {
        "$value": 1.45
      }
    },
    "tracking": {
      "$type": "dimension",
      "micro": {
        "$value": "0.11em",
        "$description": "微标签字距。"
      },
      "normal": {
        "$value": "0em"
      },
      "tight": {
        "$value": "-0.02em",
        "$description": "大号数字字距。"
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "sidebar": {
      "$value": "232px"
    },
    "topbar": {
      "$value": "64px"
    },
    "content-x": {
      "$value": "32px",
      "$description": "内容区左右留白。"
    },
    "content-y": {
      "$value": "24px"
    },
    "gap": {
      "$value": "24px",
      "$description": "卡片/区块间距。"
    },
    "card-pad": {
      "$value": "24px"
    },
    "control-h": {
      "$value": "36px",
      "$description": "按钮、输入框高度。"
    },
    "control-h-sm": {
      "$value": "28px",
      "$description": "分段控件高度。"
    },
    "table-row": {
      "$value": "52px"
    },
    "page-max": {
      "$value": "1440px"
    },
    "text-max": {
      "$value": "720px",
      "$description": "长文本最大行宽。"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "focus": {
    "width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "180ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ]
      }
    }
  },
  "chart": {
    "line-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "grid-width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "donut-width": {
      "$type": "dimension",
      "$value": "14px"
    },
    "spark-width": {
      "$type": "dimension",
      "$value": "1.6px"
    }
  }
}
